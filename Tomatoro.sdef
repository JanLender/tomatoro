<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Tomatoro Terminology" xmlns:xi="http://www.w3.org/2003/XInclude">
    <suite name="Standard Suite" code="core" description="Common classes and commands.">
        <xi:include href="file:///System/Library/ScriptingDefinitions/CocoaStandard.sdef" xpointer="xpointer(/dictionary/suite/*)"/>
    </suite>

    <suite name="Tomatoro Suite" code="Tmto" description="Task and record scripting for Tomatoro.">
        <record-type name="task info" code="TkIn" description="A summary of a task.">
            <property name="task id" code="TkID" type="text" description="The task's unique identifier."/>
            <property name="task name" code="TkNm" type="text" description="The task's name."/>
            <property name="task description" code="TkDs" type="text" description="The task's free-form description."/>
            <property name="task project" code="TkPr" type="text" description="The name of the task's project; empty for a task without one."/>
        </record-type>

        <class-extension extends="application" description="Adds task-related scripting to the application.">
            <property name="tasks" code="TmTk" access="r" description="All unarchived tasks.">
                <type type="task info" list="yes"/>
            </property>
        </class-extension>

        <command name="create task" code="TmtoCrTk" description="Create a task in a project. A task is identified by its project and name (both compared ignoring case): if an unarchived task with that identity exists it's returned unchanged; if it's archived it's unarchived and returned. The project must already exist; it's never created. A missing name or project, or an unknown project, is an error.">
            <cocoa class="CreateTaskCommand"/>
            <direct-parameter type="text" optional="yes" description="The name of the task."/>
            <parameter name="in project" code="InPj" type="text" optional="yes" description="The name of the (existing) project the task belongs to. Required."/>
            <parameter name="with description" code="CrDs" type="text" optional="yes" description="An optional free-form description, used only when a new task is created."/>
            <result type="task info" description="The (possibly pre-existing) task."/>
        </command>

        <command name="add record" code="TmtoAdRc" description="Add a completed work record to a task. The task is given either by its id, or by its name together with &quot;in project&quot;. A name and project that match no task create one; an archived match is unarchived first. A name without a project, or an unknown project, is an error.">
            <cocoa class="AddRecordCommand"/>
            <direct-parameter type="text" description="The id of an existing task, or a task name (which needs &quot;in project&quot;)."/>
            <parameter name="duration" code="RcDr" type="integer" description="How long the session lasted, in minutes."/>
            <parameter name="started at" code="RcSt" type="date" optional="yes" description="When the session started. Defaults to (now minus duration)."/>
            <parameter name="notes" code="RcNt" type="text" optional="yes" description="An optional free-form note about the session."/>
            <parameter name="in project" code="InPj" type="text" optional="yes" description="The name of the (existing) project; required when the task is given by name, ignored when given by id."/>
        </command>

        <command name="export worklog" code="TmtoExWl" description="Export tasks and their work records in a date range as a JSON string. Read-only; never changes any data.">
            <cocoa class="ExportWorklogCommand"/>
            <parameter name="from" code="WlFr" type="text" description="Start date, yyyy-MM-dd, local time zone, inclusive."/>
            <parameter name="to" code="WlTo" type="text" optional="yes" description="End date, yyyy-MM-dd, local time zone, inclusive. Defaults to &quot;from&quot;."/>
            <result type="text" description="JSON payload: {schemaVersion, from, to, tasks: [{id, name, projectName, estimatedHours, totalRecordedSeconds, records: [{id, startedAt, durationSeconds, description}]}]}."/>
        </command>
    </suite>
</dictionary>
